{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Angular Debug (Firefox)",
            "type": "firefox",
            "request": "launch",
            "preLaunchTask": "npm: serve-local",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}",
            "reAttach": true,
            "timeout": 30000,
            "postDebugTask": "terminate-serve-local" // Adiciona tarefa para matar o processo
        }
    ]
}